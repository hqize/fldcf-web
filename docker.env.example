# 复制为 docker.env：docker compose --env-file docker.env up --build
#
# 生产 ENV=production 时：JWT_SECRET_KEY、AUTH_INIT_PASSWORD（≥10 位）必填（见 backend/src/core/settings.py）

ENV=production

MYSQL_ROOT_PASSWORD=请改成强密码
MYSQL_DATABASE=fldcf

# 生成 JWT： python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# 首次写入数据库的管理员密码（≥10 位）
AUTH_INIT_PASSWORD=

AUTH_INIT_USERNAME=admin

# FLDCF：1/true=CPU；0/false=优先 GPU（需镜像为 CUDA 版 PyTorch，见 PYTORCH_VARIANT）
FLDCF_CPU=1

# 推理前最长边上限（像素），超限按比例缩小，减轻 OOM/502；默认 2048；0=不缩放（大图易崩）
# FLDCF_MAX_INPUT_SIDE=1536

# PyTorch 轮子：cpu（默认）| cu118（CUDA 11.8）| cu124（CUDA 12.4）；与 docker-compose.gpu.yml 一起用
# 驱动/CUDA 11.x 环境常用 cu118；较新卡/驱动可用 cu124
# PYTORCH_VARIANT=cu118

# 构建 backend 镜像：镜像站速度因地区/运营商而异，可多试几种（apt 与 pip 可分开配）
# APT_MIRROR：official | aliyun | ustc | tsinghua
# APT_MIRROR=aliyun

# PIP_MIRROR：official | aliyun | ustc | tsinghua | tencent
#   - 大包 torch：ustc/tsinghua 会走国内 pytorch-wheels；aliyun/tencent 仍走 download.pytorch.org
#   - 清华慢时可试：PIP_MIRROR=aliyun 或 PIP_MIRROR=ustc；网络好可试 official
# PIP_MIRROR=aliyun

# 浏览器访问前端的 Origin（逗号分隔）
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1

# 端口
WEB_PORT=80
BACKEND_PORT=8000
# 后端映射到宿主机的网卡：127.0.0.1=仅本机可访问 :8000（推荐）；0.0.0.0=局域网也能访问
# BACKEND_BIND=127.0.0.1
MYSQL_PORT=3306

# 可选：DeepSeek（compose 会注入 backend；模型名须与官方 API 一致）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

