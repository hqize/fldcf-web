# =============================================================================
# fldcf — Git 忽略规则
# 与 .dockerignore 分工：Git 管「是否提交」；Docker 管「是否打进 build 上下文」。
# =============================================================================

# -----------------------------------------------------------------------------
# 密钥与本地环境（勿提交）
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
docker.env
!docker.env.example
.env.local
.env.*.local

# -----------------------------------------------------------------------------
# Python（后端 backend/）
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
*.egg
dist/
build/
pip-wheel-metadata/

# 测试 / 类型 / 格式化缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
coverage.xml
.coverage
.coverage.*
htmlcov/
*.cover

# -----------------------------------------------------------------------------
# Node（前端 gp-front/）
# -----------------------------------------------------------------------------
gp-front/node_modules/
gp-front/dist/
gp-front/release/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Electron 应用图标（build/ 整体被上面 Python 段忽略，这里反选图标文件）
!gp-front/build/
!gp-front/build/icon.ico

# -----------------------------------------------------------------------------
# 操作系统与编辑器
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

.idea/
**/.idea/
.vscode/

# -----------------------------------------------------------------------------
# 论文与文档（本地撰写，不入版本库）
# -----------------------------------------------------------------------------
docs/

# -----------------------------------------------------------------------------
# 可选：若整棵 FLDCF_raw 仅本地存在、从不提交，取消下一行注释
# FLDCF_raw/

# FLDCF 权重与大包（单文件常 >100MB，GitHub 不接受；默认勿提交，部署时拷贝或 Git LFS）
backend/fldcf_data/**/*.pt
backend/fldcf_data/**/*.pth
backend/fldcf_data/**/*.ckpt
backend/fldcf_data/**/*.onnx
backend/fldcf_data/**/*.safetensors
