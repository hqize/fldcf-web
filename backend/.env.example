# 复制为 .env 后按需修改（.env 不要提交 Git）
#
# 上线时务必设置：
#   ENV=production
#   JWT_SECRET_KEY=<python -c "import secrets; print(secrets.token_hex(32))">
#   DB_URL=<你的数据库连接串>
#   AUTH_INIT_PASSWORD=<强密码，至少 10 位>
#
# 本地开发可保持或省略 ENV（默认 development）

ENV=development

# 日志：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DB_URL=mysql://root:123456@127.0.0.1:3306/fldcf

AUTH_INIT_USERNAME=admin
AUTH_INIT_PASSWORD=11111

# FLDCF：官方 FLDCF(raw) 根目录（须含子目录 src/）。不设则依次尝试：
#   本仓库根目录下的 FLDCF_raw、backend/FLDCF_raw、backend/FLDCF(raw)
# FLDCF_ROOT=

# DeepSeek（OpenAI 兼容）：供 /aichat/chat 调用，密钥勿提交 Git
# 推荐写在 backend/.env；也可单独放在 backend/src/aichat_api/.env（启动时会自动合并加载）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
